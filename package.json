{
  "name": "dotwo-teleprompter",
  "version": "0.2.0",
  "description": "Desktop teleprompter app with separate control and prompter windows.",
  "author": "Domingo Moreno / DoTwo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotwobot-dev/dotwo-teleprompter.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/control.js && node --check src/prompter.js && node --check scripts/macos-signing.js && node --check scripts/release-mac-signed.js",
    "check:mac-signing": "node scripts/macos-signing.js",
    "build:dmg-background": "xcrun swift scripts/build-dmg-background.swift",
    "pack": "electron-builder --dir",
    "pack:mac-arm64": "electron-builder --dir --arm64",
    "pack:mac-intel": "electron-builder --dir --x64",
    "pack:mac-legacy": "electron-builder --dir --x64 --config.electronVersion=26.6.10 --config.mac.minimumSystemVersion=10.13 --config.directories.output=dist-legacy",
    "release:mac": "bash scripts/release-mac.sh",
    "release:mac:signed": "node scripts/release-mac-signed.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.dotwo.teleprompter",
    "productName": "DoTwo Teleprompter",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "background": "build/dmg/background.png",
      "iconSize": 112,
      "iconTextSize": 13,
      "format": "UDZO",
      "contents": [
        { "x": 160, "y": 202, "type": "file" },
        { "x": 480, "y": 202, "type": "link", "path": "/Applications", "name": "Aplicaciones" }
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
